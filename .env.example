# =============================================================================
# Curatio Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to git - it contains secrets!

# -----------------------------------------------------------------------------
# TMDB API (Required)
# -----------------------------------------------------------------------------
# Get your API key: https://www.themoviedb.org/settings/api
# Free tier: 40 requests per 10 seconds (~240/min)
TMDB_API_KEY=your_tmdb_api_key_here

# -----------------------------------------------------------------------------
# AI tagging provider (choose one; may instead be configured in Admin Center)
# -----------------------------------------------------------------------------
# gemini | anthropic | openai
TAGGING_PROVIDER=gemini

# Get your API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# A Claude or Claude Code subscription does not include Anthropic API usage.
# Get an API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# A ChatGPT subscription does not include OpenAI API usage.
# Get an API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# A local model behind an OpenAI-compatible API (Ollama, LM Studio, ...).
# Select it with TAGGING_PROVIDER=local. Usually needs no key.
LOCAL_BASE_URL=
LOCAL_API_KEY=
LOCAL_MODEL=

# GEMINI_PAID_TIER is NOT read by the application. It is not a field on
# Settings and app/config.py uses extra="ignore", so it is swallowed at load.
# GEMINI_PAID_TIER=false

# Model to use. Tagging is closed-vocabulary classification against a <=160-tag
# menu with a Python validator behind it, not open generation, so the cheapest
# current tier is the right default. Normal rebuilds tag only the shared
# quality-eligible corpus; `workers/retag.py --estimate` prices the exact pending
# scope before any API call.
#
# Gemini model IDs are retired on a schedule; a retired ID 404s on every call.
# gemini-2.0-flash shut down 2026-06-01, gemini-2.5-flash on 2026-10-16.
# Verify with: python workers/diagnose_tagging.py
#
# Curatio prices supported models from a provider-aware table. Unknown models
# use a conservative provider-specific rate, so changing models cannot silently
# weaken the ceiling.
GEMINI_MODEL=gemini-2.5-flash-lite
TAGGING_BATCH_SIZE=20
GEMINI_MAX_ATTEMPTS=8
# Reject speculative 0.50-0.59 assignments before they enter recommendation rows.
TAG_MIN_CONFIDENCE=0.60

# Tagging quality breakers use a cheap two-stage fuse. At 200 attempted titles,
# only a catastrophic (>20%) requeue/failure rate stops the run. After 1,000,
# malformed/near-empty results may be at most 10%, and hard failures at most 2%.
TAG_CATASTROPHIC_MIN_ITEMS=200
TAG_CATASTROPHIC_RATE=0.20
TAG_CIRCUIT_BREAKER_MIN_ITEMS=1000
TAG_MAX_REQUEUE_RATE=0.10
TAG_MAX_FAILURE_RATE=0.02

# Published per-million-token rates for the model above. Known model IDs use a
# built-in price table; an unknown ID uses the more conservative of these values
# and the most expensive known Flash rate, so the ceiling cannot silently weaken.
GEMINI_INPUT_COST_PER_MTOK=0.10
GEMINI_OUTPUT_COST_PER_MTOK=0.40
RETAG_COST_CEILING_USD=20

# Library-first tagging: only titles on the connected Plex/Jellyfin servers
# (and saved to a Watchlist) are AI-tagged. Set true to also tag new TMDB
# releases nobody owns.
TAG_CATALOG_BEYOND_LIBRARY=false
# Stop AI-tagging owned titles for the month at this spend (0 = no cap).
LIBRARY_TAGGING_MONTHLY_CAP_USD=0
# Manifest URL of Curatio's initial tag pack ({"version", "url", "sha256"}).
# TAG_PACK_URL=https://github.com/curatio-app/curatio/releases/download/tag-pack/manifest.json

# -----------------------------------------------------------------------------
# Master Password (Required)
# -----------------------------------------------------------------------------
# This password gates administrator access to your Curatio dashboard.
# Share invite codes with users instead of sharing this password.
# At least 16 characters: this alone unlocks the whole admin area.
MASTER_PASSWORD=change_this_to_a_strong_password_123

# -----------------------------------------------------------------------------
# Database (Auto-configured by Docker Compose)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# If using Docker Compose, this is automatically set
DATABASE_URL=postgresql://postgres:password@postgres:5432/curatio

# Alternative for local testing without Docker
# DATABASE_URL=postgresql://localhost:5432/curatio_test

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# This server's public base URL
BASE_URL=https://yourdomain.com

# Product name shown to users
APP_NAME=Curatio

# Total movies/shows stored per catalog (more = more variety when shuffled)
CATALOG_SIZE=200

# Items returned per catalog page
CATALOG_PAGE_SIZE=100

# Randomize catalog order every N hours (0 = disabled)
CATALOG_SHUFFLE_HOURS=3

# How often to refresh universal catalogs (in hours)
UNIVERSAL_CATALOG_REFRESH_HOURS=24

# How often to refresh personalized catalogs (in hours)
PERSONALIZED_CATALOG_REFRESH_HOURS=24

# Maximum stable per-profile catalog slots
# (Trending x2, New Releases x2, BYW x5, Recommended x2, Top Picks x2,
# taste x4, Hidden Gems x2)
PERSONALIZED_CATALOG_COUNT=19

# Legacy curated catalog count (compatibility documentation only)
UNIVERSAL_CATALOG_COUNT=40

# Days between rotations through the synthesized row pool
SYNTH_ROTATION_DAYS=7

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable debug mode (shows detailed errors)
DEBUG=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Requests per minute per user (prevent abuse)
RATE_LIMIT_PER_MINUTE=60

# Reverse-proxy hops in front of the app. Keep 1 behind nginx so rate limits
# see each caller's real IP; with 0 every client shares nginx's single bucket.
# Use 0 only when clients connect to uvicorn directly.
TRUSTED_PROXY_COUNT=1

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (generate a random string)
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars

# Token expiration in days
TOKEN_EXPIRATION_DAYS=30

# -----------------------------------------------------------------------------
# Quality floor -- what may appear in ANY row, personal or curated.
# All seven are editable in the admin dashboard's Catalog tab, which previews how
# many titles a setting would keep before you save it.
# -----------------------------------------------------------------------------
# Minimum 0-10 quality, on the same signal the rows are RANKED by: MDBList's
# votes-weighted consensus where we have it, Bayesian-smoothed TMDB otherwise.
# The only rating floor in the product. 0 disables it.
CATALOG_MIN_QUALITY=6.8
# How many of IMDb/RT/Metacritic/Trakt/Letterboxd must carry a title. OR-ed with
# the vote floor below, not AND-ed -- either route in is enough. Setting either
# to 0 disables the pair.
CATALOG_MIN_RATING_SOURCES=5
# TMDB vote floor, and the way in for a title MDBList was never asked about.
CATALOG_MIN_VOTE_COUNT=1000
CATALOG_NICHE_MIN_QUALITY=7.4
CATALOG_NICHE_MIN_VOTE_COUNT=250
CATALOG_NICHE_MIN_AGE_DAYS=180
# NOT a filter: the lower bound of the multiplier that modulates relevance when
# ORDERING a row. Smaller gives quality more say over position; 1.0 turns
# modulation off. Relevance leads at any value.
CATALOG_QUALITY_WEIGHT=0.30

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable features for testing
# ENABLE_PERSONALIZED_CATALOGS hides the per-profile rows without deleting them;
# ENABLE_PERSONALIZED_SYNC below controls whether they are BUILT at all.
ENABLE_PERSONALIZED_CATALOGS=true
ENABLE_UNIVERSAL_CATALOGS=true
ENABLE_PERSONALIZED_SYNC=true

# -----------------------------------------------------------------------------
# Daily Update Scheduler
# -----------------------------------------------------------------------------
# Automatically fetch and tag new releases daily. Personal rows refresh through
# a separate zero-AI local loop even when this remains false.
# Set to 'true' to enable the in-app scheduler (no cron needed)
DAILY_UPDATE_ENABLED=false

# Time to run the daily update (HH:MM in UTC)
# Default: 03:00 (3 AM UTC)
DAILY_UPDATE_TIME=03:00

# Overall deadline (seconds) before a single daily update run is killed.
# Guards against a run that hangs and never finishes. Default: 1800 (30 min)
DAILY_UPDATE_TIMEOUT=1800

# Per-request timeout (seconds) for Gemini tagging calls.
# Prevents a stalled AI request from blocking the update. Default: 120
GEMINI_REQUEST_TIMEOUT=120

# -----------------------------------------------------------------------------
# Performance Tuning
# -----------------------------------------------------------------------------
# Number of workers for Uvicorn
WORKERS=4

# Database connection pool size
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4

# Decoder threads per background fingerprint FFmpeg process. These jobs run in
# the web container; keep this at 1 unless it has dedicated CPU capacity.
FINGERPRINT_FFMPEG_THREADS=1

# Cache TTL (time to live) in seconds
CACHE_TTL=3600

# Complete native-detail snapshots warm independently of the paid daily update.
# The pass is resumable, skips fresh rows, and never exceeds four background
# provider builds, preserving foreground capacity for a title being opened.
DETAIL_SNAPSHOT_WARM_ENABLED=true
DETAIL_SNAPSHOT_WARM_INTERVAL_SECONDS=3600
DETAIL_SNAPSHOT_WARM_STARTUP_DELAY_SECONDS=10
DETAIL_SNAPSHOT_WARM_CONCURRENCY=2
# Prioritized active shelf/library/history titles per pass; 0 means unlimited.
DETAIL_SNAPSHOT_WARM_LIMIT=2000

# Browser playback compatibility fallback. Native/client playback stays first;
# these bound the low-CPU H.264 -> HLS server fallback used by Safari/iOS and
# browsers that cannot remux a source locally.
PLAYBACK_REMUX_MAX_STREAMS=3
PLAYBACK_REMUX_IDLE_TIMEOUT=90
# Full video transcoding for browsers (CPU-heavy). Off: transcode-only sources
# fail over and the web player suggests the desktop app. Toggleable in the admin panel.
ALLOW_SERVER_TRANSCODE=false
PLAYBACK_TRANSCODE_MAX_STREAMS=1

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------
# Skip API key validation (for testing)
# NEVER set to true in production!
SKIP_API_VALIDATION=false
