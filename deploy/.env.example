# =============================================================================
# Curatio Server settings
# Copy to .env (cp .env.example .env) and replace every "change_me" value.
# Keep .env private: it holds your passwords and keys.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Your domain, with https:// and no trailing slash. The apps connect here.
BASE_URL=https://curatio.example.com

# Same domain without https://. Used by the bundled Caddy for HTTPS.
CURATIO_DOMAIN=curatio.example.com

# Free key from https://www.themoviedb.org/settings/api ("API Key", not the token).
TMDB_API_KEY=your_tmdb_api_key_here

# Admin break-glass password, at least 16 characters.
MASTER_PASSWORD=change_this_to_a_strong_password_123

# Random secret, at least 32 characters. Generate one with: openssl rand -hex 32
# Never change it after setup: it encrypts your stored Plex/Jellyfin tokens.
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars

# Database password. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change_me

# --- AI tagging (optional; can also be set in Admin → Tagging) ---------------
# Without a key, Curatio still tags titles with rule-based tags (genre, era,
# country). An AI key makes picks sharper. You pay the provider directly; a
# typical library costs cents. Only titles on your servers (and your
# Watchlists) are tagged.
#
# gemini | anthropic | openai | local
TAGGING_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# A free local model instead (Ollama, LM Studio...): set TAGGING_PROVIDER=local
# LOCAL_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_MODEL=qwen2.5:14b

# Stop AI tagging for the month at this spend in USD (0 = no cap).
LIBRARY_TAGGING_MONTHLY_CAP_USD=5

# --- Advanced ------------------------------------------------------------------

# Set to 0.0.0.0 only if your own reverse proxy runs on another machine.
# CURATIO_LISTEN=127.0.0.1

# Pin a specific server version instead of the latest.
# CURATIO_IMAGE=ghcr.io/curatio-app/curatio:latest

LOG_LEVEL=INFO
